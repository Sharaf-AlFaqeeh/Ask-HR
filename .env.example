# Vector Database Path Override
# VECTOR_DB_PATH=C:/Data/qdrant_db

# Security & API Secrets
API_BEARER_TOKEN=askhr_super_secret_token_2026
SAP_CLIENT_SECRET=mock_successfactors_client_secret_xyz123
