# ==============================================================================
# AskHR Enterprise AI Orchestration Engine - Environment Variables
# ==============================================================================
# Copy this file to '.env' in the root directory and modify values as needed.
# Do NOT commit '.env' to git repository.

# Application General Environment
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Service Port Overrides
LLM_SERVICE_PORT=8000
ORCHESTRATOR_SERVICE_PORT=8080

